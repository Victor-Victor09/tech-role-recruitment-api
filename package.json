{
  "name": "tech-role-recruiting-api",
  "version": "0.1.0",
  "description": "Recruiting System for Tech Roles — backend REST API (Node.js/Express/Sequelize)",
  "homepage": "https://github.com/Victor-Victor09/tech-role-recruitment-api#readme",
  "bugs": {
    "url": "https://github.com/Victor-Victor09/tech-role-recruitment-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Victor-Victor09/tech-role-recruitment-api.git"
  },
  "author": "Victor, Kolade, and Glory",
  "type": "module",
  "main": "server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "test": "echo \"add unit/integration tests under tests/, then wire a runner here\" && exit 0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
